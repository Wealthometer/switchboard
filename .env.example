# Used by docker compose. For local development without Docker, see api/.env.example.

# Required. Generate with: openssl rand -hex 32
JWT_SECRET=
POSTGRES_PASSWORD=switchboard
# The address people open; used in email links.
APP_URL=http://localhost:8080
# Set to true when serving over HTTPS.
COOKIE_SECURE=false
# Real email (defaults to the bundled Mailpit at http://localhost:8025):
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# MAIL_FROM=Acme Support <support@acme.com>
# Hours before solved tickets close automatically:
# AUTO_CLOSE_HOURS=168
