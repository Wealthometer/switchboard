# Copy to .env for local development (npm run dev). Docker Compose sets these itself.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/switchboard
REDIS_URL=redis://localhost:6379/0
# 32+ random characters: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-0123456789
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
# Leave empty to log emails as JSON; or point at Mailpit: smtp://localhost:1025
SMTP_URL=
MAIL_FROM=Switchboard <support@localhost>
